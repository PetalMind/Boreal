    "activityTrackingDescription": {"comment": "Short explanation of how product activity is measured.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Activity is measured while this game is launched through Boreal. Offline play and other launchers may not be included."}}, "pl": {"stringUnit": {"state": "translated", "value": "Aktywność jest mierzona, gdy ta gra jest uruchamiana przez Boreal. Gra offline i inne programy uruchamiające mogą nie być uwzględniane."}}}, "extractionState": "manual"},
    "learnMore": {"comment": "Action that opens activity tracking details.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Learn more"}}, "pl": {"stringUnit": {"state": "translated", "value": "Dowiedz się więcej"}}}, "extractionState": "manual"},
    "activityTrackingDetails": {"comment": "Detailed explanation of locally recorded product activity.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Boreal records elapsed time while a managed game session is active. These statistics use locally recorded sessions; store-reported playtime can differ. Sessions interrupted when Boreal closes may be incomplete."}}, "pl": {"stringUnit": {"state": "translated", "value": "Boreal rejestruje czas, gdy zarządzana sesja gry jest aktywna. Statystyki korzystają z sesji zapisanych lokalnie, więc czas raportowany przez sklep może się różnić. Sesje przerwane po zamknięciu Boreal mogą być niepełne."}}}, "extractionState": "manual"},
    "thisWeek": {"comment": "Activity dashboard current week card title.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This week"}}, "pl": {"stringUnit": {"state": "translated", "value": "Ten tydzień"}}}, "extractionState": "manual"},
    "lastWeek": {"comment": "Activity dashboard previous week label.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Last week"}}, "pl": {"stringUnit": {"state": "translated", "value": "Zeszły tydzień"}}}, "extractionState": "manual"},

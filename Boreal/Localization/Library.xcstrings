    "activityTrackingDescription": {"comment": "Short explanation of how product activity is measured.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Activity is measured while this game is launched through Boreal. Offline play and other launchers may not be included."}}, "pl": {"stringUnit": {"state": "translated", "value": "Aktywność jest mierzona, gdy ta gra jest uruchamiana przez Boreal. Gra offline i inne programy uruchamiające mogą nie być uwzględniane."}}}, "extractionState": "manual"},

    "appleGamingWikiDisclaimer": {"comment": "Compatibility source disclaimer.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "AppleGamingWiki ratings are community data and do not replace a Boreal-tested profile."}}, "pl": {"stringUnit": {"state": "translated", "value": "Oceny AppleGamingWiki pochodzą od społeczności i nie zastępują profilu przetestowanego przez Boreal."}}}, "extractionState": "manual"},
    "wineCompatibilityDisclaimer": {"comment": "Wine compatibility estimate disclaimer.", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This compatibility estimate is not a guarantee for Boreal's Wine configuration."}}, "pl": {"stringUnit": {"state": "translated", "value": "Ta szacunkowa ocena zgodności nie jest gwarancją działania w konfiguracji Wine programu Boreal."}}}, "extractionState": "manual"},

    "activityTrackingDescription" : {
      "comment" : "Short explanation of how product activity is measured.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activity is measured while this game is launched through Boreal. Offline play and other launchers may not be included."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywność jest mierzona, gdy ta gra jest uruchamiana przez Boreal. Gra offline i inne programy uruchamiające mogą nie być uwzględniane."
          }
        }
      }
    },
    "activityTrackingDetails" : {
      "comment" : "Detailed explanation of locally recorded product activity.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boreal records elapsed time while a managed game session is active. These statistics use locally recorded sessions; store-reported playtime can differ. Sessions interrupted when Boreal closes may be incomplete."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boreal rejestruje czas, gdy zarządzana sesja gry jest aktywna. Statystyki korzystają z sesji zapisanych lokalnie, więc czas raportowany przez sklep może się różnić. Sesje przerwane po zamknięciu Boreal mogą być niepełne."
          }
        }
      }
    },
